# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values. `.env` is git-ignored.
# All variables are optional except the Telegram ones (needed for alerts).
# ---------------------------------------------------------------------------

# --- Telegram (secrets) ----------------------------------------------------
# Create a bot with @BotFather to get the token. Get your chat id by messaging
# the bot then visiting https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Default search (overridable via CLI flags) ----------------------------
# Seeded with: SYD -> ADL, depart 8 Aug, return 11 Aug, 3 adults + 1 child,
# tracking the CASH price via Google Flights (the default provider).
SEARCH_ORIGIN=SYD
SEARCH_DESTINATION=ADL
SEARCH_DEPARTURE_DATE=2025-08-08
SEARCH_RETURN_DATE=2025-08-11
SEARCH_ADULTS=3
SEARCH_CHILDREN=1
SEARCH_INFANTS=0
SEARCH_CABIN=economy
# 'cash' (Google Flights) or 'points' (Qantas Classic Rewards)
SEARCH_FARE_TYPE=cash
# Threshold: AUD when fare_type=cash, POINTS when fare_type=points.
SEARCH_TARGET_PRICE=300

# --- Qantas provider (only used with --provider qantas) --------------------
# Optional: path to a saved Playwright storage_state JSON captured after
# logging in once (see scripts/capture_qantas_session.py). Reward pricing is
# only fully visible to logged-in Frequent Flyer members.
QANTAS_STORAGE_STATE=
QANTAS_SCREENSHOT_DIR=screenshots

# --- App runtime -----------------------------------------------------------
APP_LOG_LEVEL=INFO
# Run the browser headless (true) or visible (false, for debugging selectors).
APP_HEADLESS=true
APP_REQUEST_TIMEOUT_MS=45000
# Seconds between checks when polling.
APP_POLL_INTERVAL_SECONDS=1800
# Stop after N checks (leave blank for unlimited).
APP_MAX_CHECKS=
# Send a message even when nothing is under target (useful for testing).
APP_NOTIFY_ON_NO_MATCH=false
